{
  "name": "hiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx --yes prisma@6.19.0 generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean-prisma": "rimraf node_modules/.prisma node_modules/@prisma",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "npx prisma@6.19.0 generate || echo 'Prisma generate will run during build'",
    "reset": "npm run clean-prisma && npm install && npm run prisma:push",
    "diagnose": "tsx scripts/diagnose.ts",
    "fix:campaigns": "npx tsx scripts/fix-stuck-campaigns.ts",
    "check:keys": "npx tsx scripts/check-which-keys-exist.ts",
    "add:missing-keys": "npx tsx scripts/add-missing-keys.ts",
    "test:keys": "npx tsx scripts/test-nvidia-keys.ts",
    "validate:env": "npx tsx scripts/validate-env-and-credentials.ts",
    "test:redis": "npx tsx scripts/test-redis-connection.ts",
    "verify:migrations": "npx tsx scripts/verify-database-migrations.ts",
    "verify:webhook": "npx tsx scripts/verify-facebook-webhook.ts",
    "verify:monitoring": "npx tsx scripts/verify-error-monitoring.ts",
    "verify:db-pool": "npx tsx scripts/verify-db-pool-settings.ts",
    "verify:all": "npm run verify:migrations && npm run test:redis && npm run verify:webhook && npm run verify:monitoring",
    "check:rate-limit": "npx tsx scripts/check-rate-limiting.ts",
    "validate:timeouts": "npx tsx scripts/validate-timeout-settings.ts",
    "backup:db": "npx tsx scripts/backup-database.ts",
    "restore:db": "npx tsx scripts/restore-database.ts",
    "cleanup:db": "npx tsx scripts/cleanup-database.ts",
    "vercel-build": "prisma generate && (prisma migrate deploy || prisma db push --accept-data-loss) && next build",
    "ngrok:start": "node scripts/start-ngrok.js",
    "ngrok:stop": "node scripts/stop-ngrok.js",
    "dev:with-ngrok": "concurrently \"npm run dev\" \"npm run ngrok:start\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fal-ai/client": "^1.7.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.0",
    "@prisma/engines": "^6.19.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.81.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tiptap/react": "^3.10.5",
    "@tiptap/starter-kit": "^3.10.5",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.65.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.553.0",
    "next": "16.0.1",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.7.3",
    "openai": "^4.104.0",
    "papaparse": "^5.5.3",
    "prisma": "6.19.0",
    "react": "19.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.66.0",
    "recharts": "^3.4.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "use-debounce": "^10.0.6",
    "zod": "^4.1.12",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.0",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^29.7.0",
    "rimraf": "^6.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2"
  }
}
