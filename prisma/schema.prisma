model ApiKey {
  id                  String       @id @default(cuid())
  name                String? // Optional descriptive name
  encryptedKey        String       @db.Text // Encrypted API key
  status              ApiKeyStatus @default(ACTIVE)
  rateLimitedAt       DateTime? // When rate limit was hit
  lastUsedAt          DateTime?
  lastSuccessAt       DateTime?
  totalRequests       Int          @default(0)
  failedRequests      Int          @default(0)
  consecutiveFailures Int          @default(0)
  metadata            Json? // Store key prefix, provider, etc.
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status, rateLimitedAt])
  @@index([status])
}

enum ApiKeyStatus {
  ACTIVE
  RATE_LIMITED
  DISABLED
}

model PageAccess {
  id        String   @id @default(cuid())
  userId    String
  pagePath  String // e.g., "/dashboard", "/contacts", "/campaigns"
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pagePath])
  @@index([userId])
  @@index([pagePath])
}

model AssistantChat {
  id             String             @id @default(cuid())
  userId         String
  organizationId String
  title          String? // Auto-generated from first message
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       AssistantMessage[]

  @@index([userId, createdAt])
  @@index([organizationId])
}

model AssistantMessage {
  id        String        @id @default(cuid())
  chatId    String
  role      MessageRole   @default(USER)
  content   String        @db.Text
  metadata  Json? // Store sources, citations, etc.
  createdAt DateTime      @default(now())
  chat      AssistantChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ConversationCache {
  id           String   @id @default(cuid())
  hash         String   @unique
  analysisData String   @db.Text
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([hash])
  @@index([expiresAt])
}

model PerformanceMetric {
  id        String   @id @default(cuid())
  operation String
  duration  Int // Duration in milliseconds
  success   Boolean
  errorType String?
  apiKeyId  String?
  requestId String?
  priority  String?
  metadata  Json? // Additional context data
  createdAt DateTime @default(now())

  @@index([operation, createdAt])
  @@index([success, createdAt])
  @@index([createdAt])
  @@index([apiKeyId, createdAt])
}

model ErrorLog {
  id        String   @id @default(cuid())
  level     String   @default("error") // error, warn, info
  message   String   @db.Text
  stack     String?  @db.Text // Full stack trace
  errorType String? // Error class name
  errorCode String? // Custom error code
  context   Json? // Additional context (request ID, user ID, etc.)
  metadata  Json? // Additional metadata
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([errorType, createdAt])
  @@index([createdAt])
  @@index([errorCode])
}

model JobLog {
  id        String   @id @default(cuid())
  jobType   String // e.g., "cron-send-scheduled", "background-sync", "ai-automations"
  jobId     String? // Related job ID (e.g., SyncJob.id, Campaign.id)
  status    String // "started", "progress", "completed", "failed", "cancelled"
  message   String   @db.Text
  progress  Int? // Progress percentage (0-100)
  metadata  Json? // Additional context (counts, errors, etc.)
  error     String?  @db.Text // Error message if failed
  stack     String?  @db.Text // Stack trace if failed
  duration  Int? // Duration in milliseconds (for completed jobs)
  createdAt DateTime @default(now())

  @@index([jobType, createdAt])
  @@index([jobId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model SystemAlert {
  id             String        @id @default(cuid())
  type           AlertType
  severity       AlertSeverity @default(WARNING)
  title          String
  message        String        @db.Text
  status         AlertStatus   @default(ACTIVE)
  metadata       Json? // Additional context (key IDs, connection counts, etc.)
  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String? // User ID who acknowledged
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([type, status, createdAt])
  @@index([status, createdAt])
  @@index([severity, createdAt])
  @@index([createdAt])
}

enum AlertType {
  API_RATE_LIMIT_EXHAUSTION
  DATABASE_CONNECTION_ISSUE
  DATABASE_POOL_EXHAUSTION
  MEMORY_LEAK_DETECTED
  SYSTEM_ERROR
  JOB_FAILURE
  HIGH_ERROR_RATE
  PERFORMANCE_DEGRADATION
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  ACKNOWLEDGED
}
